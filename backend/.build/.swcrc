{
  "$schema": "https://json.schemastore.org/swcrc",
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "exclude": [".test.ts", ".spec.ts", "__mocks__", "dist", "node_modules"],
  "minify": true
}
