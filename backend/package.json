{
  "name": "gazintech",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prisma:pull": "dotenv -e .env.development -- npx prisma db pull",
    "prisma:generate:development": "dotenv -e .env.development -- npx prisma generate",
    "prisma:generate": "npx prisma generate",
    "prisma:migratedev": "dotenv -e .env.development -- npx prisma migrate dev",
    "prisma:migratedeploy": "dotenv -e .env.development -- npx prisma migrate deploy",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:sandbox": "cross-env NODE_ENV=sandbox nest start --watch",
    "start:debug:sandbox": "cross-env NODE_ENV=sandbox nest start --debug --watch",
    "start:production": "cross-env NODE_ENV=production nest start --watch",
    "start:debug:production": "cross-env NODE_ENV=production nest start --debug --watch",
    "start:debug": "nest start --debug --watch",
    "start:migrate:prod": "prisma migrate deploy && npm run start:prod",
    "start:prod": "node dist/main",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage ",
    "test:unit": "vitest run --config vite.config.unit.ts",
    "test:unit:cov": "vitest run --config vite.config.unit.ts --coverage",
    "test:e2e": "vitest run --config vite.config.e2e.ts",
    "test:e2e:cov": "vitest run --config vite.config.e2e.ts --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^10.1.3",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.1.3",
    "@nestjs/jwt": "^10.1.1",
    "@nestjs/platform-express": "^10.1.3",
    "@nestjs/swagger": "^7.1.8",
    "@prisma/client": "^6.2.1",
    "axios": "^1.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "express": "4.18.2",
    "joi": "^17.13.3",
    "nestjs-pino": "^4.0.0",
    "pino-http": "^9.0.0",
    "pino-pretty": "10.3.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@swc/cli": "^0.1.62",
    "@swc/core": "^1.3.76",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitest/coverage-v8": "^0.34.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-import-helpers": "^1.3.1",
    "eslint-plugin-prettier": "^4.2.1",
    "lint-staged": "^15.2.10",
    "prettier": "^2.8.8",
    "prisma": "^6.2.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "unplugin": "^1.14.1",
    "unplugin-swc": "^1.3.2",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "0.34.1"
  }
}