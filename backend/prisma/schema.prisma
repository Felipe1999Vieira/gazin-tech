generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sexo {
  M
  F
}

model Nivel {
  id              Int             @id @default(autoincrement())
  nivel           String          @unique
  desenvolvedores Desenvolvedor[]
}

model Desenvolvedor {
  id              Int      @id @default(autoincrement())
  nivel_id        Int
  nome            String
  sexo            Sexo     
  data_nascimento DateTime
  hobby           String?
  nivel           Nivel    @relation(fields: [nivel_id], references: [id], onDelete: Cascade)
}
